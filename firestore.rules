rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidSquad(data) {
      return data.code is string &&
             data.status in ['active', 'ended'] &&
             data.name is string;
    }

    // Squads collection
    match /squads/{squadId} {
      // Anyone can query squads by public code or retrieve by ID
      allow read: if true;

      // Allow creating an active squad with valid metadata
      allow create: if isValidSquad(request.resource.data);

      // Allow updating squad settings, destination, name, status, or regroup point
      allow update: if resource.data.status == 'active' || request.resource.data.status == 'ended';

      // Squads should not be hard-deleted from clients
      allow delete: if false;

      // Members subcollection: convoy tracking & presence
      match /members/{userId} {
        allow read: if true;
        allow write: if true;
      }

      // Chat messages subcollection
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string;
        allow update, delete: if false;
      }

      // Regroup and place suggestions subcollection
      match /suggestions/{suggestionId} {
        allow read: if true;
        allow write: if true;
      }
    }
  }
}
